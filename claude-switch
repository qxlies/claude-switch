#!/usr/bin/env python3
"""
claude-switch: switch accounts in Claude Desktop (macOS) while keeping the local workspace shared.

How Claude Desktop (4.4xxx) stores things:
  * Auth: claude.ai cookies (the Cookies file, sessionKey*) plus the oauth:tokenCache* keys in config.json.
    Values are encrypted with the "Claude Safe Storage" Keychain key, which is the same for every account,
    so a snapshot can simply be copied away and put back.
  * Local Code and Cowork sessions live in <userData>/claude-code-sessions/<accountUuid>/<orgUuid>/
    and <userData>/local-agent-mode-sessions/<accountUuid>/<orgUuid>/. Another account looks in another
    folder, which is why chats seem to disappear.
  * Symlinks don't work: the app opens these folders with O_NOFOLLOW and treats a symlink as tampering.
    So on every switch the workspace folder is physically moved under the new account's IDs.
  * lastKnownAccountUuid in config.json must match the account, otherwise on startup the app decides a
    different person signed in and wipes its token cache and connectors.
  * If Gateway (3P) mode is configured, an app started without a claude.ai sign-in drops the stored
    "claude.ai" choice (deploymentMode in <userData>-3p/claude_desktop_config.json) and relaunches into
    Gateway. So the script sets deploymentMode=1p and launches the app with --claude-first-party-sign-in,
    the same way the app does when you pick "sign in with claude.ai".
  * Sidebar sections and groups, permission modes and other per-account settings live in the claude.ai
    origin's localStorage (keys "LSS-persisted.*", a LevelDB database under "Local Storage"), which is
    saved per account with the sign-in. claude_desktop_config.json is only a mirror that the app rewrites
    from there on startup, so these settings are copied in the localStorage as well.

Everything is done while the app is closed. A backup is made before every switch.
"""
import argparse
import copy
import json
import os
import shutil
import signal
import sqlite3
import struct
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

VERSION = "1.2.0"
REPO = "qxlies/claude-switch"
BUNDLE_ID = "com.anthropic.claudefordesktop"
APP_BUNDLE_ID = "io.github.qxlies.claude-switch"
APP_DIR = Path(os.environ.get("CLAUDE_SWITCH_APPDIR", Path.home() / "Library/Application Support/Claude"))
HOME = Path(os.environ.get("CLAUDE_SWITCH_HOME", Path.home() / ".claude-switch"))
STATE_FILE = HOME / "state.json"
LOG_FILE = HOME / "switch.log"
LOCK_FILE = HOME / "worker.lock"
KEEP_BACKUPS = 8
# Where the app stores the claude.ai / Gateway mode choice
MODE_FILE = APP_DIR.parent / (APP_DIR.name + "-3p") / "claude_desktop_config.json"
FIRST_PARTY_FLAG = "--claude-first-party-sign-in"
LOGIN_TIMEOUT = int(os.environ.get("CLAUDE_SWITCH_LOGIN_TIMEOUT", 900))

# Web profile files that belong to an account
AUTH_PATHS = ["Cookies", "Cookies-journal", "Local Storage", "Session Storage", "IndexedDB"]
# config.json keys that belong to an account
AUTH_KEYS = [
    "oauth:tokenCache",
    "oauth:tokenCacheV2",
    "lastKnownAccountUuid",
    "bootSideSessions",
    "sshTransportFlagLastAnswer",
    "windowSizeWasSignedIn",
    "coworkTrustedDeviceToken",
]
# Workspace folders, keyed by <acct>/<org>
WORKSPACE_DIRS = ["claude-code-sessions", "local-agent-mode-sessions"]
# Per-account settings that are NOT carried over (server-side gates and rate-limit counters)
PREF_DENY = ("bypassPermissionsGateByAccount", "autoResumeRateLimit", "auto-mode-denial-count")

NO_APP = bool(os.environ.get("CLAUDE_SWITCH_NO_APP"))  # --no-app: don't touch the app itself (for tests)


# ───────────────────────── helpers ─────────────────────────

def log(msg):
    line = f"[{datetime.now():%H:%M:%S}] {msg}"
    print(line, flush=True)


def die(msg, code=1):
    log(f"ERROR: {msg}")
    notify(msg, "Claude Switch: error")
    sys.exit(code)


def notify(text, title="Claude Switch"):
    if NO_APP or os.environ.get("CLAUDE_SWITCH_NO_NOTIFY"):  # the app shows its own progress
        return
    subprocess.run(["osascript", "-e", f"display notification {json.dumps(text)} with title {json.dumps(title)}"],
                   capture_output=True)


def read_json(path, default=None):
    try:
        raw = Path(path).read_text(encoding="utf-8")
    except FileNotFoundError:
        return default
    return json.loads(raw)


def write_json(path, data):
    """Atomic write that keeps the original file's indentation and trailing newline."""
    path = Path(path)
    indent, trailing = 2, ""
    if path.exists():
        raw = path.read_text(encoding="utf-8")
        trailing = "\n" if raw.endswith("\n") else ""
        if raw.startswith("{\n\t"):
            indent = "\t"
        elif raw.startswith("{\n"):
            indent = len(raw[2:]) - len(raw[2:].lstrip(" ")) or 2
        elif raw.startswith("{") and not raw.startswith("{\n"):
            indent = None
    tmp = path.with_name(path.name + ".claude-switch.tmp")
    tmp.write_text(json.dumps(data, indent=indent, ensure_ascii=False) + trailing, encoding="utf-8")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def rm(path):
    path = Path(path)
    if path.is_dir() and not path.is_symlink():
        shutil.rmtree(path)
    elif path.exists() or path.is_symlink():
        path.unlink()


def copy_any(src, dst):
    src, dst = Path(src), Path(dst)
    rm(dst)
    dst.parent.mkdir(parents=True, exist_ok=True)
    if src.is_dir():
        shutil.copytree(src, dst, symlinks=True)
    else:
        shutil.copy2(src, dst)


def short(uuid):
    return (uuid or "?")[:8]


def lock_owner():
    """PID of a running switch operation, or None."""
    try:
        pid = int(LOCK_FILE.read_text().strip())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def acquire_lock():
    pid = lock_owner()
    if pid and pid != os.getpid():
        die(f"Another switch is already running (pid {pid}). Wait for it to finish.")
    HOME.mkdir(mode=0o700, parents=True, exist_ok=True)
    LOCK_FILE.write_text(str(os.getpid()))
    import atexit
    atexit.register(lambda: LOCK_FILE.unlink() if lock_owner() in (None, os.getpid()) and LOCK_FILE.exists() else None)


# ───────────────────────── state ─────────────────────────

def load_state():
    st = read_json(STATE_FILE, None) or {}
    st.setdefault("profiles", {})
    st.setdefault("workspace", None)  # {"acct":..., "org":...}: where the workspace physically lives now
    return st


def save_state(st):
    HOME.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, indent=2, ensure_ascii=False), encoding="utf-8")
    os.replace(tmp, STATE_FILE)


def profile_dir(name):
    return HOME / "profiles" / name


def profile_by_acct(st, acct):
    for name, p in st["profiles"].items():
        if p.get("accountUuid") == acct:
            return name
    return None


# ───────────────────────── the app ─────────────────────────

def app_pid():
    r = subprocess.run(["lsappinfo", "info", "-only", "pid", "-app", BUNDLE_ID], capture_output=True, text=True)
    for tok in r.stdout.replace('"', " ").replace("=", " ").split():
        if tok.isdigit():
            return int(tok)
    return None


def app_running():
    if NO_APP:
        return False
    r = subprocess.run(["osascript", "-e", f'application id "{BUNDLE_ID}" is running'], capture_output=True, text=True)
    return r.stdout.strip() == "true"


def quit_app(force=False, timeout=60):
    if not app_running():
        return
    log("Quitting Claude… (confirm if the app asks)")
    subprocess.run(["osascript", "-e", f'tell application id "{BUNDLE_ID}" to quit'], capture_output=True)
    deadline = time.time() + timeout
    while time.time() < deadline:
        if not app_running():
            time.sleep(1.5)  # let it finish writing config.json and cookies
            return
        time.sleep(1)
    pid = app_pid()
    if force and pid:
        log(f"Claude did not quit within {timeout}s, sending SIGTERM (pid {pid})")
        os.kill(pid, signal.SIGTERM)
        for _ in range(20):
            time.sleep(1)
            if not app_running():
                time.sleep(1.5)
                return
        die("Claude still did not quit. Quit it manually (⌘Q) and try again.")
    die("Claude did not quit. Quit it manually (⌘Q) and try again, or run with --force.")


def force_first_party():
    """Keep the app out of Gateway mode: the mode choice must be claude.ai (1p)."""
    d = read_json(MODE_FILE)
    if d is not None and d.get("deploymentMode") != "1p":
        log(f"App mode was '{d.get('deploymentMode') or 'not chosen'}', setting it to claude.ai")
        d["deploymentMode"] = "1p"
        write_json(MODE_FILE, d)


def launch_app():
    force_first_party()
    if NO_APP:
        return
    subprocess.run(["open", "-b", BUNDLE_ID, "--args", FIRST_PARTY_FLAG])


# ───────────────────────── current account ─────────────────────────

def app_config():
    return read_json(APP_DIR / "config.json", {}) or {}


def has_session_cookie():
    db = APP_DIR / "Cookies"
    if not db.exists():
        return False
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro&immutable=1", uri=True)
        n = con.execute("select count(*) from cookies where host_key like '%claude.ai' and name like 'sessionKey%'").fetchone()[0]
        con.close()
        return n > 0
    except sqlite3.Error:
        return False


def current_account():
    cfg = app_config()
    acct = cfg.get("lastKnownAccountUuid")
    logged_in = bool(acct) and bool(cfg.get("oauth:tokenCacheV2") or cfg.get("oauth:tokenCache") or has_session_cookie())
    return acct if logged_in else None


def org_dirs(acct):
    found = {}
    for fam in WORKSPACE_DIRS:
        base = APP_DIR / fam / acct
        if base.is_dir():
            for d in base.iterdir():
                if d.is_dir() and len(d.name) == 36:
                    found[d.name] = max(found.get(d.name, 0), d.stat().st_mtime)
    return found


def detect_org(acct, cfg=None):
    cfg = cfg if cfg is not None else app_config()
    s = cfg.get("sshTransportFlagLastAnswer") or {}
    if s.get("accountUuid") == acct and s.get("orgUuid"):
        return s["orgUuid"]
    prefs = (read_json(APP_DIR / "claude_desktop_config.json", {}) or {}).get("preferences", {})
    for v in (prefs.get("epitaxyPrefs") or {}).values():
        if isinstance(v, dict):
            for k in v:
                if isinstance(k, str) and k.startswith(acct + "/"):
                    return k.split("/", 1)[1]
    dirs = org_dirs(acct)
    if dirs:
        return max(dirs, key=dirs.get)
    stamps = {k.rsplit(":", 1)[1]: v for k, v in cfg.items() if k.startswith("dxt:allowlistLastUpdated:")}
    if stamps:
        return max(stamps, key=stamps.get)
    return None


# ───────────────────────── auth snapshots ─────────────────────────

def snapshot_auth(name):
    """Save the sign-in currently in the app into profile `name`. The app must be closed."""
    pdir = profile_dir(name) / "auth"
    tmp = pdir.with_name("auth.tmp")
    rm(tmp)
    tmp.mkdir(parents=True)
    for p in AUTH_PATHS:
        if (APP_DIR / p).exists():
            copy_any(APP_DIR / p, tmp / p)
    cfg = app_config()
    keys = {k: cfg[k] for k in AUTH_KEYS if k in cfg}
    (tmp / "config-keys.json").write_text(json.dumps(keys, indent=2), encoding="utf-8")
    rm(pdir)
    tmp.rename(pdir)
    for d in (HOME / "profiles", profile_dir(name), pdir):
        os.chmod(d, 0o700)


def clear_auth():
    """Put the app into the signed-out state without touching the workspace or settings."""
    for p in AUTH_PATHS:
        rm(APP_DIR / p)
    cfg = app_config()
    for k in AUTH_KEYS:
        cfg.pop(k, None)
    write_json(APP_DIR / "config.json", cfg)


def restore_auth(name):
    pdir = profile_dir(name) / "auth"
    if not pdir.is_dir():
        log(f"Profile '{name}' has no saved sign-in yet: Claude will open on the sign-in screen.")
        clear_auth()
        return False
    for p in AUTH_PATHS:
        rm(APP_DIR / p)
        if (pdir / p).exists():
            copy_any(pdir / p, APP_DIR / p)
    keys = read_json(pdir / "config-keys.json", {}) or {}
    cfg = app_config()
    for k in AUTH_KEYS:
        cfg.pop(k, None)
    cfg.update(keys)
    write_json(APP_DIR / "config.json", cfg)
    return True


# ───────────────────────── Local Storage (LevelDB) ─────────────────────────
# The app keeps some settings (the sidebar's sections and groups among them) in the claude.ai origin's
# localStorage, which Chromium stores as a LevelDB database in <userData>/Local Storage/leveldb. On startup
# it rewrites claude_desktop_config.json from there, so a copy made only in the JSON file is lost.
# Below is a small LevelDB reader and writer (standard library only). Reading takes the live tables listed
# in the MANIFEST plus the logs; writing adds a new log file that LevelDB replays the next time it opens.
# Both run only while the app is closed.

LDB_BLOCK = 32768
LDB_TABLE_MAGIC = 0xDB4775248B80FB57


def _varint(buf, pos):
    result = shift = 0
    while True:
        b = buf[pos]
        pos += 1
        result |= (b & 0x7F) << shift
        if b < 0x80:
            return result, pos
        shift += 7


def _put_varint(n):
    out = bytearray()
    while n >= 0x80:
        out.append((n & 0x7F) | 0x80)
        n >>= 7
    out.append(n)
    return bytes(out)


def _lenprefixed(buf, pos):
    n, pos = _varint(buf, pos)
    return buf[pos:pos + n], pos + n


_CRC32C = []


def _crc32c(data):
    if not _CRC32C:
        for i in range(256):
            c = i
            for _ in range(8):
                c = (c >> 1) ^ 0x82F63B78 if c & 1 else c >> 1
            _CRC32C.append(c)
    crc = 0xFFFFFFFF
    for b in data:
        crc = _CRC32C[(crc ^ b) & 0xFF] ^ (crc >> 8)
    return crc ^ 0xFFFFFFFF


def _masked_crc(data):
    c = _crc32c(data)
    return ((((c >> 15) | (c << 17)) & 0xFFFFFFFF) + 0xA282EAD8) & 0xFFFFFFFF


def _snappy_decompress(buf):
    size, pos = _varint(buf, 0)
    out = bytearray()
    while pos < len(buf):
        tag = buf[pos]
        pos += 1
        kind = tag & 3
        if kind == 0:  # literal
            n = tag >> 2
            if n >= 60:
                nb = n - 59
                n = int.from_bytes(buf[pos:pos + nb], "little")
                pos += nb
            n += 1
            out += buf[pos:pos + n]
            pos += n
            continue
        if kind == 1:
            n, off = ((tag >> 2) & 7) + 4, ((tag >> 5) << 8) | buf[pos]
            pos += 1
        elif kind == 2:
            n, off = (tag >> 2) + 1, int.from_bytes(buf[pos:pos + 2], "little")
            pos += 2
        else:
            n, off = (tag >> 2) + 1, int.from_bytes(buf[pos:pos + 4], "little")
            pos += 4
        if not 0 < off <= len(out):
            raise ValueError("snappy: bad copy offset")
        start = len(out) - off
        if off >= n:
            out += out[start:start + n]
        else:  # overlapping copy repeats the last `off` bytes
            for i in range(n):
                out.append(out[start + i])
    if len(out) != size:
        raise ValueError("snappy: bad length")
    return bytes(out)


def _log_records(data):
    """Logical records of a LevelDB log file. Stops at the first damaged or unfinished record."""
    pos, frag = 0, None
    while pos + 7 <= len(data):
        left = LDB_BLOCK - pos % LDB_BLOCK
        if left < 7:  # block trailer
            pos += left
            continue
        crc, n, kind = struct.unpack_from("<IHB", data, pos)
        body = data[pos + 7:pos + 7 + n]
        if kind == 0 or len(body) < n or _masked_crc(bytes([kind]) + body) != crc:
            return
        pos += 7 + n
        if kind == 1:  # FULL
            frag = None
            yield body
        elif kind == 2:  # FIRST
            frag = bytearray(body)
        elif kind == 3 and frag is not None:  # MIDDLE
            frag += body
        elif kind == 4 and frag is not None:  # LAST
            frag += body
            yield bytes(frag)
            frag = None


def _log_encode(record):
    """One record in LevelDB log format, for a new file (so it starts at a block boundary)."""
    out, pos, first = bytearray(), 0, True
    while True:
        left = LDB_BLOCK - len(out) % LDB_BLOCK
        if left < 7:
            out += b"\0" * left
            left = LDB_BLOCK
        chunk = record[pos:pos + left - 7]
        pos += len(chunk)
        last = pos >= len(record)
        kind = 1 if first and last else 2 if first else 4 if last else 3
        out += struct.pack("<IHB", _masked_crc(bytes([kind]) + chunk), len(chunk), kind) + chunk
        first = False
        if last:
            return bytes(out)


def _batch_entries(rec):
    """(sequence, key, value-or-None) for every operation in a WriteBatch."""
    seq, count = struct.unpack_from("<QI", rec, 0)
    pos = 12
    for i in range(count):
        kind = rec[pos]
        key, pos = _lenprefixed(rec, pos + 1)
        val = None
        if kind == 1:
            val, pos = _lenprefixed(rec, pos)
        yield seq + i, bytes(key), None if val is None else bytes(val)


def _table_block(data, offset, size):
    raw = data[offset:offset + size]
    kind = data[offset + size]
    if kind == 1:
        return _snappy_decompress(raw)
    if kind != 0:
        raise ValueError(f"table: unknown block compression {kind}")
    return raw


def _block_entries(block):
    restarts = struct.unpack_from("<I", block, len(block) - 4)[0]
    end = len(block) - 4 - 4 * restarts
    pos, key = 0, b""
    while pos < end:
        shared, pos = _varint(block, pos)
        unshared, pos = _varint(block, pos)
        vlen, pos = _varint(block, pos)
        key = key[:shared] + block[pos:pos + unshared]
        pos += unshared
        yield key, block[pos:pos + vlen]
        pos += vlen


def _table_entries(data):
    """(sequence, key, value-or-None) for every entry of an .ldb table."""
    if len(data) < 48 or struct.unpack_from("<Q", data, len(data) - 8)[0] != LDB_TABLE_MAGIC:
        raise ValueError("table: bad footer")
    pos = len(data) - 48
    _, pos = _varint(data, pos)  # metaindex handle
    _, pos = _varint(data, pos)
    idx_off, pos = _varint(data, pos)
    idx_size, pos = _varint(data, pos)
    for _, handle in _block_entries(_table_block(data, idx_off, idx_size)):
        off, p = _varint(handle, 0)
        size, _ = _varint(handle, p)
        for ikey, val in _block_entries(_table_block(data, off, size)):
            tag = struct.unpack_from("<Q", ikey, len(ikey) - 8)[0]
            yield tag >> 8, bytes(ikey[:-8]), bytes(val) if tag & 0xFF == 1 else None


def _manifest(dbdir):
    """Live table numbers, log numbers and counters from the MANIFEST that CURRENT points to."""
    name = (dbdir / "CURRENT").read_text().strip()
    st = {"files": set(), "log": 0, "prev_log": 0, "next": 0, "last_seq": 0}
    for rec in _log_records((dbdir / name).read_bytes()):
        pos = 0
        while pos < len(rec):
            tag, pos = _varint(rec, pos)
            if tag == 1:  # comparator
                cmp_name, pos = _lenprefixed(rec, pos)
                if bytes(cmp_name) != b"leveldb.BytewiseComparator":
                    raise ValueError(f"unexpected comparator {bytes(cmp_name)!r}")
            elif tag in (2, 3, 4, 9):
                v, pos = _varint(rec, pos)
                st[{2: "log", 3: "next", 4: "last_seq", 9: "prev_log"}[tag]] = v
            elif tag == 5:  # compact pointer
                _, pos = _varint(rec, pos)
                _, pos = _lenprefixed(rec, pos)
            elif tag == 6:  # deleted file
                _, pos = _varint(rec, pos)
                num, pos = _varint(rec, pos)
                st["files"].discard(num)
            elif tag == 7:  # new file
                _, pos = _varint(rec, pos)
                num, pos = _varint(rec, pos)
                _, pos = _varint(rec, pos)
                _, pos = _lenprefixed(rec, pos)
                _, pos = _lenprefixed(rec, pos)
                st["files"].add(num)
            else:
                raise ValueError(f"MANIFEST: unknown tag {tag}")
    return st


def _numbered(dbdir, suffix):
    out = {}
    for p in dbdir.iterdir():
        if p.suffix == suffix and p.stem.isdigit():
            out[int(p.stem)] = p
    return out


def ldb_read(dbdir):
    """All live key/value pairs of a closed LevelDB database, and its highest sequence number."""
    dbdir = Path(dbdir)
    st = _manifest(dbdir)
    best = {}
    top = st["last_seq"]

    def put(seq, key, val):
        nonlocal top
        top = max(top, seq)
        if key not in best or best[key][0] < seq:
            best[key] = (seq, val)

    tables = {**_numbered(dbdir, ".sst"), **_numbered(dbdir, ".ldb")}
    for num in st["files"]:
        if num not in tables:
            raise FileNotFoundError(f"table {num:06d}.ldb listed in the MANIFEST is missing")
        for e in _table_entries(tables[num].read_bytes()):
            put(*e)
    for num, p in sorted(_numbered(dbdir, ".log").items()):
        if num >= st["log"] or num == st["prev_log"]:
            for rec in _log_records(p.read_bytes()):
                for e in _batch_entries(rec):
                    put(*e)
    return {k: v for k, (_, v) in best.items() if v is not None}, top


def ldb_write(dbdir, updates):
    """Apply {key: value, or None to delete} as one batch in a new log file."""
    if not updates:
        return
    dbdir = Path(dbdir)
    st = _manifest(dbdir)
    _, top = ldb_read(dbdir)
    batch = bytearray(struct.pack("<QI", top + 1, len(updates)))
    for key, val in updates.items():
        batch += (b"\x00" if val is None else b"\x01") + _put_varint(len(key)) + key
        if val is not None:
            batch += _put_varint(len(val)) + val
    used = [int(p.stem) for p in dbdir.iterdir() if p.stem.isdigit()]
    num = max([st["next"], st["log"] + 1] + [n + 1 for n in used])
    tmp = dbdir / f"{num:06d}.log.tmp"
    tmp.write_bytes(_log_encode(bytes(batch)))
    tmp.rename(dbdir / f"{num:06d}.log")


# Chromium's localStorage rows: "_<origin>\0" + key and value, each a 1-byte encoding tag + text
LS_ORIGIN = "https://claude.ai"


def _ls_decode(b):
    return b[1:].decode("latin-1") if b[:1] == b"\x01" else b[1:].decode("utf-16-le")


def _ls_encode(s):
    try:
        return b"\x01" + s.encode("latin-1")
    except UnicodeEncodeError:
        return b"\x00" + s.encode("utf-16-le")


def ls_read(storage_dir, origin=LS_ORIGIN):
    """{key: text} of one origin's localStorage in a (closed) "Local Storage" folder."""
    prefix = b"_" + origin.encode() + b"\x00"
    rows, _ = ldb_read(Path(storage_dir) / "leveldb")
    return {_ls_decode(k[len(prefix):]): _ls_decode(v) for k, v in rows.items() if k.startswith(prefix)}


def ls_write(storage_dir, items, origin=LS_ORIGIN):
    """Set {key: text} in one origin's localStorage."""
    prefix = b"_" + origin.encode() + b"\x00"
    ldb_write(Path(storage_dir) / "leveldb", {prefix + _ls_encode(k): _ls_encode(v) for k, v in items.items()})


