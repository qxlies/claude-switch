def merge_move(src, dst, conflicts):
    """Move src into dst. On a conflict src (the workspace being carried) wins; dst's copy goes to `conflicts`."""
    if not src.exists():
        return
    if not dst.exists():
        dst.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.rename(src, dst)
        return
    for entry in list(src.iterdir()):
        target = dst / entry.name
        if not target.exists():
            os.rename(entry, target)
        elif entry.is_dir() and target.is_dir():
            merge_move(entry, target, conflicts / entry.name)
        else:
            conflicts.mkdir(parents=True, exist_ok=True)
            os.rename(target, conflicts / entry.name)
            os.rename(entry, target)
    try:
        src.rmdir()
    except OSError:
        pass


def move_workspace(src_acct, src_org, dst_acct, dst_org, backup_dir):
    if (src_acct, src_org) == (dst_acct, dst_org):
        return
    log(f"Moving workspace {short(src_acct)}/{short(src_org)} → {short(dst_acct)}/{short(dst_org)}")
    for fam in WORKSPACE_DIRS:
        src = APP_DIR / fam / src_acct / src_org
        dst = APP_DIR / fam / dst_acct / dst_org
        merge_move(src, dst, backup_dir / "conflicts" / fam)
        try:
            (APP_DIR / fam / src_acct).rmdir()  # drop the now-empty account folder
        except OSError:
            pass


def copy_prefs(src_acct, src_org, dst_acct, dst_org):
    """Copy per-account settings (sidebar groups and sections, permission modes, presets)."""
    if src_acct == dst_acct and src_org == dst_org:
        return
    path = APP_DIR / "claude_desktop_config.json"
    d = read_json(path)
    if d:
        prefs = d.get("preferences", {})
        for k, v in list(prefs.items()):
            if k.endswith("ByAccount") and isinstance(v, dict) and k not in PREF_DENY and src_acct in v:
                v[dst_acct] = copy.deepcopy(v[src_acct])
        ep = prefs.get("epitaxyPrefs") or {}
        src_pair, dst_pair = f"{src_acct}/{src_org}", f"{dst_acct}/{dst_org}"
        for k, v in list(ep.items()):
            if any(x in k for x in PREF_DENY):
                continue
            if k.endswith("." + src_acct):
                ep[k[: -len(src_acct)] + dst_acct] = copy.deepcopy(v)
            elif isinstance(v, dict) and src_pair in v:
                v[dst_pair] = copy.deepcopy(v[src_pair])
        write_json(path, d)
    path = APP_DIR / "ccd-session-presets.json"
    d = read_json(path)
    if d and src_acct in d.get("byAccount", {}):
        d["byAccount"][dst_acct] = copy.deepcopy(d["byAccount"][src_acct])
        write_json(path, d)


# localStorage keys that mirror what copy_prefs copies: "LSS-persisted.<epitaxyPrefs key>" and the presets
LS_PREF_PREFIXES = ("LSS-persisted.", "persisted.ccd-session-presets.")


def _ls_pairs(j):
    """The dict that maps "<acct>/<org>" to a value inside a persisted setting ({"value": {...}, ...})."""
    if isinstance(j, dict) and isinstance(j.get("value"), dict):
        return j["value"]
    return j if isinstance(j, dict) else None


def copy_local_storage(src_dir, src_acct, src_org, dst_acct, dst_org, bdir):
    """The copy_prefs rules applied to the app's localStorage, which is what the app actually reads:
    take the settings from the source account's saved Local Storage and write them into the one the app
    will open now. Never fails a switch: on any error it logs a warning and leaves the target as it was."""
    dst_dir = APP_DIR / "Local Storage"
    if (src_acct, src_org) == (dst_acct, dst_org):
        return
    if not (src_dir / "leveldb").is_dir() or not (dst_dir / "leveldb").is_dir():
        return
    try:
        src, dst = ls_read(src_dir), ls_read(dst_dir)
    except Exception as e:  # noqa: BLE001 (an unexpected database must not stop the switch)
        log(f"Warning: could not read Claude's Local Storage ({e}). Sidebar sections were not carried over.")
        return
    src_pair, dst_pair = f"{src_acct}/{src_org}", f"{dst_acct}/{dst_org}"
    now = int(time.time() * 1000)
    out = {}
    for k, raw in src.items():
        if not k.startswith(LS_PREF_PREFIXES) or any(x in k for x in PREF_DENY):
            continue
        if k.endswith("." + src_acct):  # "<pref>.<acct>", sometimes "<pref>.<org>.<acct>"
            nk = k[: -len(src_acct)] + dst_acct
            out[nk.replace(f".{src_org}.", f".{dst_org}.")] = raw
            continue
        try:
            sj = json.loads(raw)
        except ValueError:
            continue
        sp = _ls_pairs(sj)
        if not sp or src_pair not in sp:
            continue
        try:
            dj = json.loads(dst[k]) if k in dst else None
        except ValueError:
            dj = None
        dp = _ls_pairs(dj)
        if dp is not None and dp.get(dst_pair) == sp[src_pair]:
            continue  # already the same
        if dp is None:
            dj = copy.deepcopy(sj)
            dp = _ls_pairs(dj)
        dp[dst_pair] = copy.deepcopy(sp[src_pair])
        if isinstance(dj, dict) and "timestamp" in dj:
            dj["timestamp"] = now
        out[k] = json.dumps(dj, separators=(",", ":"), ensure_ascii=False)
    out = {k: v for k, v in out.items() if dst.get(k) != v}
    if not out:
        return
    shutil.copytree(dst_dir, bdir / "Local Storage", symlinks=True, dirs_exist_ok=True)
    try:
        ls_write(dst_dir, out)
    except Exception as e:  # noqa: BLE001
        for p in (dst_dir / "leveldb").glob("*.log.tmp"):
            p.unlink()
        log(f"Warning: could not write Claude's Local Storage ({e}). Sidebar sections were not carried over.")
        return
    log(f"Carried {len(out)} setting(s) over in Claude's Local Storage (sidebar sections and groups among them)")


def make_backup(tag):
    bdir = HOME / "backups" / f"{datetime.now():%Y%m%d-%H%M%S-%f}-{tag}"
    bdir.mkdir(parents=True)
    for f in ["config.json", "claude_desktop_config.json", "ccd-session-presets.json"]:
        if (APP_DIR / f).exists():
            shutil.copy2(APP_DIR / f, bdir / f)
    for fam in WORKSPACE_DIRS:
        if (APP_DIR / fam).is_dir():
            shutil.copytree(APP_DIR / fam, bdir / fam, symlinks=True,
                            ignore=shutil.ignore_patterns("skills-plugin", "rpm"))
    old = sorted((HOME / "backups").iterdir())
    for b in old[:-KEEP_BACKUPS]:
        shutil.rmtree(b, ignore_errors=True)
    return bdir


